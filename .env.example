# Plantilla de variables. Copiala a .env.local para desarrollo y replicala en
# Vercel para produccion. NUNCA pongas valores reales en este archivo: es el
# unico .env que se versiona.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://www.percherosdecorativos.com

# --- Supabase (catalogo, ordenes y registro de mensajes) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Pagos (Bold) ---
NEXT_PUBLIC_BOLD_API_KEY=
BOLD_SECRET_KEY=
NEXT_PUBLIC_BOLD_CURRENCY=COP

# --- Panel de administracion ---
# Sin esta variable, /admin queda bloqueado por completo.
ADMIN_PASSWORD=

# --- Correo del formulario de contacto (ver DEPLOY.md, punto 8) ---
# Contrasena de APLICACION de Google, no la clave de la cuenta:
# https://myaccount.google.com/apppasswords (requiere verificacion en dos pasos)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Solo si el destinatario es distinto de GMAIL_USER:
CONTACT_TO=

# Opcional: apuntar a otro servidor SMTP en vez de Gmail.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
